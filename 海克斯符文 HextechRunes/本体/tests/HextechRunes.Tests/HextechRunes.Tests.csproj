<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>HextechRunes.Tests</AssemblyName>
    <RootNamespace>HextechRunes.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HextechSts2Target Condition="'$(HextechSts2Target)' == ''">0.107.1</HextechSts2Target>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(MSBuildThisFileDirectory)../../versioned-dll-backups/$(HextechSts2Target)/game-refs</GameDataDir>
  </PropertyGroup>

  <!-- 测试自身也需要版本符号(如 0.108 起 SavedPropertiesTypeCache 需显式 Init)。 -->
  <PropertyGroup Condition="'$(HextechSts2Target)' == '0.107.1'">
    <DefineConstants>$(DefineConstants);STS2_107_1</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HextechSts2Target)' == '0.110.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER;STS2_109_OR_NEWER;STS2_110_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HextechSts2Target)' == '0.111.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER;STS2_109_OR_NEWER;STS2_110_OR_NEWER;STS2_111_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HextechRunes.csproj" />
	<ProjectReference Include="../../../HextechRunesSponsorPack/src/HextechRunesSponsorPack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="saved_property_manifest.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="static_state_manifest.$(HextechSts2Target).txt" Condition="Exists('$(MSBuildThisFileDirectory)static_state_manifest.$(HextechSts2Target).txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="patch_manifest.$(HextechSts2Target).txt" Condition="Exists('$(MSBuildThisFileDirectory)patch_manifest.$(HextechSts2Target).txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- 0.109 起游戏用 XxHash32 计算 net-id 表哈希,测试进程需要能加载它。 -->
    <Reference Include="System.IO.Hashing" Condition="Exists('$(GameDataDir)/System.IO.Hashing.dll')">
      <HintPath>$(GameDataDir)/System.IO.Hashing.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- 0.110 起 sts2.dll 的模块初始化器直接引用 Sentry.Godot；测试宿主必须带齐这两项运行时依赖。 -->
    <Reference Include="Sentry.Godot" Condition="Exists('$(GameDataDir)/Sentry.Godot.dll')">
      <HintPath>$(GameDataDir)/Sentry.Godot.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Sentry" Condition="Exists('$(GameDataDir)/Sentry.dll')">
      <HintPath>$(GameDataDir)/Sentry.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
