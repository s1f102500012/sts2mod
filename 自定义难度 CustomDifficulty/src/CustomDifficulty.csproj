<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>CustomDifficulty</AssemblyName>
    <RootNamespace>CustomDifficulty</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <CustomDiffSts2Target Condition="'$(CustomDiffSts2Target)' == ''">0.107.1</CustomDiffSts2Target>
    <GameRefsDir>$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups/$(CustomDiffSts2Target)/game-refs</GameRefsDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CustomDiffSts2Target)' == '0.108.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameRefsDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameRefsDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameRefsDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
