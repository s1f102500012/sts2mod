<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>RewardEnchants</AssemblyName>
    <RootNamespace>RewardEnchants</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <RewardEnchantsSts2Target Condition="'$(RewardEnchantsSts2Target)' == ''">0.110.1</RewardEnchantsSts2Target>
    <VersionedRefsRoot>$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups</VersionedRefsRoot>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(VersionedRefsRoot)/$(RewardEnchantsSts2Target)/game-refs</GameDataDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RewardEnchantsSts2Target)' == '0.110.1'">
    <DefineConstants>$(DefineConstants);STS2_110_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RewardEnchantsCompatibilityTarget" Value="$(RewardEnchantsSts2Target)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
