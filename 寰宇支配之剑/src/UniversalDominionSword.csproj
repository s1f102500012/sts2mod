<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>UniversalDominionSword</AssemblyName>
    <RootNamespace>UniversalDominionSword</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UniversalDominionSwordSts2Target Condition="'$(UniversalDominionSwordSts2Target)' == ''">0.111.0</UniversalDominionSwordSts2Target>
    <VersionedRefsRoot>$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups</VersionedRefsRoot>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(VersionedRefsRoot)/$(UniversalDominionSwordSts2Target)/game-refs</GameDataDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
  </PropertyGroup>

  <!-- 只发布真正维护的游戏版本;共享代码不写 #if,版本差异收在整文件分部文件里(*.Legacy.cs / *.Official.cs)。 -->
  <PropertyGroup Condition="'$(UniversalDominionSwordSts2Target)' == '0.107.1'">
    <DefineConstants>$(DefineConstants);STS2_107_1</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UniversalDominionSwordSts2Target)' == '0.110.0' or '$(UniversalDominionSwordSts2Target)' == '0.111.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <Target Name="UniversalDominionSwordValidateTarget" BeforeTargets="CoreCompile" Condition="'$(UniversalDominionSwordSts2Target)' != '0.107.1' and '$(UniversalDominionSwordSts2Target)' != '0.110.0' and '$(UniversalDominionSwordSts2Target)' != '0.111.0'">
    <Error Text="UniversalDominionSwordSts2Target '$(UniversalDominionSwordSts2Target)' is not a shipped variant (0.107.1 / 0.110.0 / 0.111.0)." />
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="UniversalDominionSwordCompatibilityTarget" Value="$(UniversalDominionSwordSts2Target)" />
    <InternalsVisibleTo Include="UniversalDominionSword.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
