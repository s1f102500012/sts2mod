<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>EndlessMode</AssemblyName>
    <RootNamespace>EndlessMode</RootNamespace>
    <Version>0.4.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EndlessSts2Target Condition="'$(EndlessSts2Target)' == ''">0.107.1</EndlessSts2Target>
    <GameRefsDir>$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups/$(EndlessSts2Target)/game-refs</GameRefsDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EndlessSts2Target)' == '0.108.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EndlessSts2Target)' == '0.109.0'">
    <DefineConstants>$(DefineConstants);STS2_108_OR_NEWER;STS2_109_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameRefsDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameRefsDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameRefsDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../assets/images/relics/*.png" LogicalName="EndlessMode.images.relics.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
