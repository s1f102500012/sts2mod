<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>Heartsteel</AssemblyName>
    <RootNamespace>Heartsteel</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <HeartsteelSts2Target Condition="'$(HeartsteelSts2Target)' == ''">0.107.1</HeartsteelSts2Target>
    <VersionedRefsRoot>$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups</VersionedRefsRoot>
    <OfficialGameDataPath>$(VersionedRefsRoot)/$(HeartsteelSts2Target)/game-refs</OfficialGameDataPath>
    <GameDataPath Condition="'$(GameDataPath)' == ''">$(OfficialGameDataPath)</GameDataPath>
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">/Users/iniad/Library/Application Support/Steam/steamapps/workshop/content/2868840/3747602295</RitsuLibRoot>
    <RitsuLibCompatibilityTarget Condition="'$(HeartsteelSts2Target)' == '0.110.1'">0.110.0</RitsuLibCompatibilityTarget>
    <RitsuLibCompatibilityTarget Condition="'$(RitsuLibCompatibilityTarget)' == ''">$(HeartsteelSts2Target)</RitsuLibCompatibilityTarget>
    <RitsuLibHintPath Condition="'$(RitsuLibHintPath)' == ''">$(RitsuLibRoot)/lib/$(RitsuLibCompatibilityTarget)/STS2-RitsuLib.dll</RitsuLibHintPath>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HeartsteelCompatibilityTarget" Value="$(HeartsteelSts2Target)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(HeartsteelSts2Target)' == '0.110.1'">
    <DefineConstants>$(DefineConstants);STS2_110_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataPath)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataPath)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib">
      <HintPath>$(RitsuLibHintPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
