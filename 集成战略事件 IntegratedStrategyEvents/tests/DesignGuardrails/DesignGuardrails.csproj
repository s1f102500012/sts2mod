<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IntegratedStrategySts2Target Condition="'$(IntegratedStrategySts2Target)' == ''">0.110.1</IntegratedStrategySts2Target>
    <VersionedRefsRoot>$(MSBuildThisFileDirectory)../../../HextechRunes/versioned-dll-backups</VersionedRefsRoot>
    <GameDataPath Condition="'$(GameDataPath)' == ''">$(VersionedRefsRoot)/$(IntegratedStrategySts2Target)/game-refs</GameDataPath>
    <GameRuntimeDataPath Condition="'$(GameRuntimeDataPath)' == ''">/Users/iniad/Library/Application Support/Steam/steamapps/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</GameRuntimeDataPath>
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">/Users/iniad/Library/Application Support/Steam/steamapps/workshop/content/2868840/3747602295</RitsuLibRoot>
    <RitsuLibTarget Condition="'$(RitsuLibTarget)' == '' and '$(IntegratedStrategySts2Target)' == '0.110.1'">0.110.0</RitsuLibTarget>
    <RitsuLibTarget Condition="'$(RitsuLibTarget)' == ''">$(IntegratedStrategySts2Target)</RitsuLibTarget>
    <IntegratedStrategyAssembly Condition="'$(IntegratedStrategyAssembly)' == ''">$(MSBuildThisFileDirectory)../../dist/lib/$(IntegratedStrategySts2Target)/IntegratedStrategyEvents.dll</IntegratedStrategyAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataPath)/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataPath)/GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataPath)/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Hashing" Condition="('$(IntegratedStrategySts2Target)' == '0.110.1' or '$(IntegratedStrategySts2Target)' == '0.111.0') and Exists('$(GameRuntimeDataPath)/System.IO.Hashing.dll')">
      <HintPath>$(GameRuntimeDataPath)/System.IO.Hashing.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Sentry.Godot" Condition="('$(IntegratedStrategySts2Target)' == '0.110.1' or '$(IntegratedStrategySts2Target)' == '0.111.0') and Exists('$(GameRuntimeDataPath)/Sentry.Godot.dll')">
      <HintPath>$(GameRuntimeDataPath)/Sentry.Godot.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Sentry" Condition="('$(IntegratedStrategySts2Target)' == '0.110.1' or '$(IntegratedStrategySts2Target)' == '0.111.0') and Exists('$(GameRuntimeDataPath)/Sentry.dll')">
      <HintPath>$(GameRuntimeDataPath)/Sentry.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib">
      <HintPath>$(RitsuLibRoot)/lib/$(RitsuLibTarget)/STS2-RitsuLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="IntegratedStrategyEvents">
      <HintPath>$(IntegratedStrategyAssembly)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateProbeInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(IntegratedStrategyAssembly)')" Text="Missing IntegratedStrategyEvents variant: $(IntegratedStrategyAssembly)" />
    <Error Condition="!Exists('$(RitsuLibRoot)/lib/$(RitsuLibTarget)/STS2-RitsuLib.dll')" Text="Missing RitsuLib variant $(RitsuLibTarget) for STS2 $(IntegratedStrategySts2Target)." />
    <Error Condition="('$(IntegratedStrategySts2Target)' == '0.110.1' or '$(IntegratedStrategySts2Target)' == '0.111.0') and !Exists('$(GameRuntimeDataPath)/Sentry.Godot.dll')" Text="Missing Sentry.Godot runtime dependency for the STS2 0.110.1 probe." />
    <Error Condition="('$(IntegratedStrategySts2Target)' == '0.110.1' or '$(IntegratedStrategySts2Target)' == '0.111.0') and !Exists('$(GameRuntimeDataPath)/Sentry.dll')" Text="Missing Sentry runtime dependency for the STS2 0.110.1 probe." />
  </Target>
</Project>
