<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IntegratedStrategyEvents</AssemblyName>
    <RootNamespace>IntegratedStrategyEvents</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>0.5.6</Version>
    <AssemblyVersion>0.5.6.0</AssemblyVersion>
    <FileVersion>0.5.6.0</FileVersion>
    <InformationalVersion>0.5.6</InformationalVersion>
    <IntegratedStrategySts2Target Condition="'$(IntegratedStrategySts2Target)' == ''">0.107.1</IntegratedStrategySts2Target>
    <VersionedRefsRoot>$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups</VersionedRefsRoot>
    <OfficialGameDataPath>$(VersionedRefsRoot)/$(IntegratedStrategySts2Target)/game-refs</OfficialGameDataPath>
    <GameDataPath Condition="'$(GameDataPath)' == ''">$(OfficialGameDataPath)</GameDataPath>
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">/Users/iniad/Library/Application Support/Steam/steamapps/workshop/content/2868840/3747602295</RitsuLibRoot>
    <RitsuLibTarget Condition="'$(RitsuLibTarget)' == '' and '$(IntegratedStrategySts2Target)' == '0.110.1'">0.110.0</RitsuLibTarget>
    <RitsuLibTarget Condition="'$(RitsuLibTarget)' == ''">$(IntegratedStrategySts2Target)</RitsuLibTarget>
    <RitsuLibHintPath Condition="'$(RitsuLibHintPath)' == ''">$(RitsuLibRoot)/lib/$(RitsuLibTarget)/STS2-RitsuLib.dll</RitsuLibHintPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IntegratedStrategySts2Target)' == '0.110.1' or '$(IntegratedStrategySts2Target)' == '0.111.0'">
    <DefineConstants>$(DefineConstants);STS2_109_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="IntegratedStrategyEventsCompatibilityTarget" Value="$(IntegratedStrategySts2Target)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataPath)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataPath)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib">
      <HintPath>$(RitsuLibHintPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(IntegratedStrategySts2Target)' == '0.111.0'">
    <DefineConstants>$(DefineConstants);STS2_111_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../tests/snapshots/$(IntegratedStrategySts2Target)/vanilla_guard.txt" LogicalName="vanilla_guard.txt" Condition="Exists('$(MSBuildThisFileDirectory)../tests/snapshots/$(IntegratedStrategySts2Target)/vanilla_guard.txt')" />
  </ItemGroup>
  <Target Name="ValidateMaintainedTarget" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(IntegratedStrategySts2Target)' != '0.107.1' and '$(IntegratedStrategySts2Target)' != '0.110.1' and '$(IntegratedStrategySts2Target)' != '0.111.0'" Text="Unsupported STS2 target: $(IntegratedStrategySts2Target). Maintained: 0.107.1, 0.110.1, 0.111.0." />
  </Target>
</Project>
