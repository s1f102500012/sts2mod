<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IntegratedStrategyEvents</AssemblyName>
    <RootNamespace>IntegratedStrategyEvents</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>0.5.4</Version>
    <AssemblyVersion>0.5.4.0</AssemblyVersion>
    <FileVersion>0.5.4.0</FileVersion>
    <InformationalVersion>0.5.4</InformationalVersion>
    <IntegratedStrategySts2Target Condition="'$(IntegratedStrategySts2Target)' == ''">0.107.1</IntegratedStrategySts2Target>
    <VersionedRefsRoot>$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups</VersionedRefsRoot>
    <OfficialGameDataPath>$(VersionedRefsRoot)/$(IntegratedStrategySts2Target)/game-refs</OfficialGameDataPath>
    <GameDataPath Condition="'$(GameDataPath)' == ''">$(OfficialGameDataPath)</GameDataPath>
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">/Users/iniad/Library/Application Support/Steam/steamapps/workshop/content/2868840/3747602295</RitsuLibRoot>
    <RitsuLibHintPath Condition="'$(RitsuLibHintPath)' == ''">$(RitsuLibRoot)/lib/$(IntegratedStrategySts2Target)/STS2-RitsuLib.dll</RitsuLibHintPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IntegratedStrategySts2Target)' == '0.109.0'">
    <DefineConstants>$(DefineConstants);STS2_109_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="IntegratedStrategyEventsCompatibilityTarget" Value="$(IntegratedStrategySts2Target)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataPath)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataPath)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="STS2-RitsuLib">
      <HintPath>$(RitsuLibHintPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
